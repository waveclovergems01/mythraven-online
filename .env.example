# Public identifier for Google Identity Services, not a client secret.
# Create a Web application OAuth client; see docs/GOOGLE_AUTH_SETUP.md.
GOOGLE_CLIENT_ID=
WEB_PORT=5273
AUTH_PORT=5274
# Blank allows localhost and 127.0.0.1 on WEB_PORT.
AUTH_ORIGINS=
# Use true with HTTPS in a future production setup.
AUTH_SECURE_COOKIES=false

# Local Colyseus multiplayer. Run npm run dev to start all three processes.
GAME_PORT=5275
# Optional override; defaults to ws://<browser-hostname>:<GAME_PORT> locally.
VITE_GAME_SERVER_URL=
