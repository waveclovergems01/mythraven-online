# Public identifier for Google Identity Services, not a client secret.
# Create a Web application OAuth client; see docs/GOOGLE_AUTH_SETUP.md.
GOOGLE_CLIENT_ID=
AUTH_PORT=3001
AUTH_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Use true with HTTPS in a future production setup.
AUTH_SECURE_COOKIES=false
